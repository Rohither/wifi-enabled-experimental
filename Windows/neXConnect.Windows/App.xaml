<Application x:Class="NeXConnect.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="TealBrush" Color="#18B8C9" />
        <SolidColorBrush x:Key="GreenBrush" Color="#26A879" />
        <SolidColorBrush x:Key="PageBrush" Color="#E6F4F7FA" />
        <SolidColorBrush x:Key="CardBrush" Color="#E6FFFFFF" />
        <SolidColorBrush x:Key="InputBrush" Color="#FFF8FAFC" />
        <SolidColorBrush x:Key="InkBrush" Color="#FF142A3A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF7D8D99" />
        <SolidColorBrush x:Key="BorderBrush" Color="#FFDCE5E8" />
        <Style TargetType="TextBox"><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="Background" Value="{DynamicResource InputBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="Background" Value="{DynamicResource InputBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/></Style>
        <Style TargetType="DataGrid"><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="RowBackground" Value="{DynamicResource CardBrush}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource InputBrush}"/><Setter Property="GridLinesVisibility" Value="Horizontal"/></Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Application.Resources>
</Application>
