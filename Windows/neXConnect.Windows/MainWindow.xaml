<Window x:Class="NeXConnect.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="neX Connect" Width="1120" Height="760" MinWidth="840" MinHeight="600"
        Background="Transparent" Foreground="{DynamicResource InkBrush}"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="neX Connect" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,30,0" Foreground="{DynamicResource InkBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="Monitor" Tag="Monitor" Click="Navigate_Click" />
                    <Button Content="History" Tag="History" Click="Navigate_Click" />
                    <Button Content="Settings" Tag="Settings" Click="Navigate_Click" />
                    <Button Content="About" Tag="About" Click="Navigate_Click" />
                </StackPanel>
                <TextBlock x:Name="HeaderStatus" DockPanel.Dock="Right" Text="Bluetooth is starting…" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>
        <Frame x:Name="PageFrame" NavigationUIVisibility="Hidden" Background="Transparent" />
    </DockPanel>
</Window>
